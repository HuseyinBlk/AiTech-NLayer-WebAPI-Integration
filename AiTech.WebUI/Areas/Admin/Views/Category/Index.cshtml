@model List<ResultCategoryDto>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
    int count = 0;
}

<h3>Kategoriler</h3>

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Kategori Adı</th>
        <th>İşlemler</th>
    </tr>
    
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td>@item.Title</td>
            <td>
                <a class="btn btn-danger" asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                <a class="btn btn-warning" asp-area="Admin" asp-controller="Category" asp-action="Update" asp-route-id="@item.Id">Güncelle</a>
            </td>
        </tr>
    }
</table>

<td><a class="btn btn-primary" asp-area="Admin" asp-controller="Category" asp-action="Create" >Ekle</a></td>
