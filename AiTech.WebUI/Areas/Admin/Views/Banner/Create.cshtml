@model CreateBannerDto

@{
    ViewBag.Title = "Yeni Banner Ekle";
    Layout = "_Layout";
}

<div class="card shadow-sm col-md-8 mx-auto mt-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Yeni Banner Oluştur</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Banner Başlığı</label>
                <input asp-for="Title" class="form-control" placeholder="Örn: Yapay Zeka ile Geleceği Şekillendirin" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Banner altındaki açıklama metni..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label fw-bold">Görsel URL / Yolu</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="Örn: /AI-html-v1.0.0/img/hero-img.jpg" />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="LButtonText" class="form-label fw-bold">Sol Buton Metni</label>
                    <input asp-for="LButtonText" class="form-control" placeholder="Örn: Keşfet" />
                    <span asp-validation-for="LButtonText" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LButtonUrl" class="form-label fw-bold">Sol Buton Linki</label>
                    <input asp-for="LButtonUrl" class="form-control" placeholder="Örn: /About" />
                    <span asp-validation-for="LButtonUrl" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="RButtonText" class="form-label fw-bold">Sağ Buton Metni</label>
                    <input asp-for="RButtonText" class="form-control" placeholder="Örn: İletişim" />
                    <span asp-validation-for="RButtonText" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="RButtonUrl" class="form-label fw-bold">Sağ Buton Linki</label>
                    <input asp-for="RButtonUrl" class="form-control" placeholder="Örn: /Contact" />
                    <span asp-validation-for="RButtonUrl" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>
