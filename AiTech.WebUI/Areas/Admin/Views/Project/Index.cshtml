@model List<ResultProjectDto>

@{
    ViewBag.Title = "Projeler";
    Layout = "_Layout";
    int count = 0;
}

<h3>Projeler</h3>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>#</th>
            <th>Görsel</th>
            <th>Proje Başlığı</th>
            <th>Kategori</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                count++;
                <tr>
                    <th>@count</th>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" style="width: 75px; height: 50px; object-fit: cover; border-radius: 4px;" />
                        }
                        else
                        {
                            <span class="text-muted">Görsel Yok</span>
                        }
                    </td>
                    <td>@item.Title</td>
                    <td>@(item.Category?.Title ?? "-")</td>
                    <td>
                        <form asp-area="Admin" asp-controller="Project" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu projeyi silmek istediğinize emin misiniz?');">
                            <button type="submit" class="btn btn-danger">Sil</button>
                        </form>
                        <a class="btn btn-warning" asp-area="Admin" asp-controller="Project" asp-action="Update" asp-route-id="@item.Id">Güncelle</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Henüz kayıtlı proje bulunmamaktadır.</td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-primary" asp-area="Admin" asp-controller="Project" asp-action="Create">Yeni Proje Ekle</a>
